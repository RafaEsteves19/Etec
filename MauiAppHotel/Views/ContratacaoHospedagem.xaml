<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Contratação de Hospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F3F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="16,20" Spacing="16">

            <!-- Cabeçalho -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <VerticalStackLayout Spacing="5">
                    <Label Text="MAUI HOTEL"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#C49A50" />

                    <Label Text="Sua estadia começa aqui"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#172B4D"
                           LineBreakMode="WordWrap" />

                    <Label Text="Preencha os dados da hospedagem."
                           FontSize="14"
                           TextColor="#667085" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Sobre"
                        Clicked="OnSobreClicked"
                        BackgroundColor="#172B4D"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="12,8"
                        VerticalOptions="Center" />
            </Grid>

            <!-- Hóspedes -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Hóspedes"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172B4D" />

                    <!-- Adultos -->
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">

                        <VerticalStackLayout Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="Adultos"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#172B4D" />

                            <Label Text="A partir de 18 anos"
                                   FontSize="12"
                                   TextColor="#667085" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="8"
                                               VerticalOptions="Center">

                            <Button Text="−"
                                    Clicked="OnDiminuirAdultos"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    CornerRadius="10"
                                    FontSize="22"
                                    BackgroundColor="#E8EDF4"
                                    TextColor="#172B4D" />

                            <Label x:Name="lbl_adultos"
                                   Text="2"
                                   WidthRequest="25"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#172B4D"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />

                            <Button Text="+"
                                    Clicked="OnAumentarAdultos"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    CornerRadius="10"
                                    FontSize="22"
                                    BackgroundColor="#172B4D"
                                    TextColor="White" />
                        </HorizontalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#E5E7EB" />

                    <!-- Crianças -->
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">

                        <VerticalStackLayout Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="Crianças"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#172B4D" />

                            <Label Text="Até 17 anos"
                                   FontSize="12"
                                   TextColor="#667085" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="8"
                                               VerticalOptions="Center">

                            <Button Text="−"
                                    Clicked="OnDiminuirCriancas"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    CornerRadius="10"
                                    FontSize="22"
                                    BackgroundColor="#E8EDF4"
                                    TextColor="#172B4D" />

                            <Label x:Name="lbl_criancas"
                                   Text="0"
                                   WidthRequest="25"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#172B4D"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />

                            <Button Text="+"
                                    Clicked="OnAumentarCriancas"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    CornerRadius="10"
                                    FontSize="22"
                                    BackgroundColor="#172B4D"
                                    TextColor="White" />
                        </HorizontalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Acomodação -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Acomodação"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172B4D" />

                    <Label Text="Selecione a suíte desejada"
                           FontSize="13"
                           TextColor="#667085" />

                    <Picker x:Name="pck_quarto"
                            ItemDisplayBinding="{Binding Descricao}"
                            Title="Selecione uma suíte"
                            TextColor="#172B4D"
                            TitleColor="#667085" />

                </VerticalStackLayout>
            </Border>

            <!-- Datas -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Período da hospedagem"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172B4D" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Check-in"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#172B4D" />

                        <DatePicker x:Name="dtpck_checkin"
                                    Format="dd/MM/yyyy"
                                    DateSelected="dtpck_checkin_DateSelected"
                                    TextColor="#172B4D" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="#E5E7EB" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Check-out"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#172B4D" />

                        <DatePicker x:Name="dtpck_checkout"
                                    Format="dd/MM/yyyy"
                                    TextColor="#172B4D" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Avançar -->
            <Button Text="Avançar"
                    Clicked="OnAvancarClicked"
                    BackgroundColor="#C49A50"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54" />

            <Label Text="MAUI HOTEL • CONFORTO E QUALIDADE"
                   FontSize="11"
                   TextColor="#98A2B3"
                   HorizontalTextAlignment="Center"
                   Margin="0,5,0,10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
