<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Contratação de Hospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F3F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="22"
                             Spacing="20">

            <!-- Cabeçalho -->
            <Grid ColumnDefinitions="*,Auto"
                  VerticalOptions="Center">

                <VerticalStackLayout Spacing="4">
                    <Label Text="MAUI HOTEL"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           TextColor="#C49A50" />

                    <Label Text="Sua estadia começa aqui"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#172B4D" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Sobre"
                        BackgroundColor="#172B4D"
                        TextColor="White"
                        CornerRadius="12"
                        Padding="16,10"
                        FontSize="13"
                        Clicked="OnSobreClicked" />

            </Grid>

            <!-- Título -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Cálculo da Diária"
                       FontFamily="Kalam"
                       FontSize="36"
                       TextColor="#172B4D" />

                <Label Text="Informe os detalhes da sua hospedagem."
                       FontSize="14"
                       TextColor="#718096" />
            </VerticalStackLayout>

            <!-- Hóspedes -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Label Text="HÓSPEDES"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="#C49A50" />

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto,2*"
                          RowSpacing="15">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Adultos"
                               FontSize="15"
                               TextColor="#172B4D"
                               VerticalOptions="Center" />

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_adultos}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#172B4D"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <Stepper Grid.Row="0"
                                 Grid.Column="2"
                                 x:Name="stp_adultos"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1"
                                 HorizontalOptions="End" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Crianças"
                               FontSize="15"
                               TextColor="#172B4D"
                               VerticalOptions="Center" />

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_criancas}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#172B4D"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <Stepper Grid.Row="1"
                                 Grid.Column="2"
                                 x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1"
                                 HorizontalOptions="End" />

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Acomodação -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="SUA ACOMODAÇÃO"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="#C49A50" />

                    <Label Text="Escolha sua suíte"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172B4D" />

                    <Picker x:Name="pck_quarto"
                            Title="Selecione sua acomodação"
                            TextColor="#172B4D"
                            TitleColor="#718096"
                            BackgroundColor="#F3F5F9" />

                </VerticalStackLayout>
            </Border>

            <!-- Período -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <Label Text="PERÍODO DA ESTADIA"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="#C49A50" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Check-in"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#172B4D" />

                        <DatePicker x:Name="dtpck_checkin"
                                    Format="dd/MM/yyyy"
                                    TextColor="#172B4D"
                                    BackgroundColor="#F3F5F9" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="#E2E8F0" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Check-out"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#172B4D" />

                        <DatePicker x:Name="dtpck_checkout"
                                    Format="dd/MM/yyyy"
                                    TextColor="#172B4D"
                                    BackgroundColor="#F3F5F9" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Botão principal -->
            <Button Text="Avançar"
                    BackgroundColor="#172B4D"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="55" />

            <!-- Rodapé -->
            <Label Text="MAUI HOTEL • CONFORTO E QUALIDADE"
                   FontSize="10"
                   CharacterSpacing="1"
                   TextColor="#94A3B8"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
