<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Inicio"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#172B4D">

    <Grid Padding="25">

        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="22">

            <Label Text="MAUI HOTEL"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#C49A50"
                   HorizontalTextAlignment="Center" />

            <Label Text="Sua próxima&#10;estadia começa aqui."
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <Label Text="Conforto, qualidade e praticidade para você aproveitar cada momento."
                   FontSize="15"
                   TextColor="#D0D5DD"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   Margin="10,0" />

            <Button Text="Iniciar reserva"
                    Clicked="OnIniciarClicked"
                    BackgroundColor="#C49A50"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="55"
                    Margin="0,15,0,0" />

            <Label Text="CONFORTO E QUALIDADE"
                   FontSize="11"
                   TextColor="#98A2B3"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,0" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
