<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F3F5F9">

    <VerticalStackLayout Padding="25"
                         Spacing="25"
                         VerticalOptions="Center">

        <Label Text="MAUI HOTEL"
               FontSize="14"
               FontAttributes="Bold"
               CharacterSpacing="4"
               TextColor="#C49A50"
               HorizontalOptions="Center" />

        <Border BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="25">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="18"
                                 HorizontalOptions="Center">

                <Label Text="Sobre o Aplicativo"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="#172B4D"
                       HorizontalTextAlignment="Center" />

                <BoxView HeightRequest="3"
                         WidthRequest="55"
                         Color="#C49A50"
                         HorizontalOptions="Center" />

                <Label Text="MAUI HOTEL"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#172B4D"
                       HorizontalTextAlignment="Center" />

                <Label Text="Aplicativo desenvolvido para gerenciamento e contratação de hospedagens."
                       FontSize="15"
                       TextColor="#718096"
                       HorizontalTextAlignment="Center" />

                <Label Text="Desenvolvedor"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#C49A50"
                       HorizontalTextAlignment="Center" />

                <Label Text="Rafael Esteves"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="#172B4D"
                       HorizontalTextAlignment="Center" />

                <Label Text="Ano de desenvolvimento: 2026"
                       FontSize="13"
                       TextColor="#718096"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar"
                BackgroundColor="#172B4D"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="55"
                Clicked="OnVoltarClicked" />

    </VerticalStackLayout>

</ContentPage>
