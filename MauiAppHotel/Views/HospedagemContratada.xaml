<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Confirmação"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F3F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="16,20" Spacing="16">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="5">

                <Label Text="MAUI HOTEL"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#C49A50" />

                <Label Text="Resumo da hospedagem"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="#172B4D"
                       LineBreakMode="WordWrap" />

                <Label Text="Confira os dados da sua reserva."
                       FontSize="14"
                       TextColor="#667085" />

            </VerticalStackLayout>

            <!-- Detalhes da reserva -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">

                    <Label Text="DETALHES DA RESERVA"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#C49A50" />

                    <Label x:Name="lbl_quarto"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#172B4D"
                           LineBreakMode="WordWrap" />

                    <BoxView HeightRequest="1"
                             Color="#E5E7EB" />

                    <Label x:Name="lbl_adultos"
                           TextColor="#344054"
                           FontSize="15" />

                    <Label x:Name="lbl_criancas"
                           TextColor="#344054"
                           FontSize="15" />

                    <Label x:Name="lbl_checkin"
                           TextColor="#344054"
                           FontSize="15" />

                    <Label x:Name="lbl_checkout"
                           TextColor="#344054"
                           FontSize="15" />

                    <Label x:Name="lbl_diarias"
                           TextColor="#344054"
                           FontSize="15" />

                    <BoxView HeightRequest="1"
                             Color="#E5E7EB" />

                    <Label Text="VALOR TOTAL"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#667085" />

                    <Label x:Name="lbl_total"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#C49A50"
                           LineBreakMode="NoWrap" />

                </VerticalStackLayout>
            </Border>

            <!-- Voltar -->
            <Button Text="Voltar"
                    BackgroundColor="#172B4D"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnVoltarClicked" />

            <Label Text="MAUI HOTEL • CONFORTO E QUALIDADE"
                   FontSize="11"
                   TextColor="#98A2B3"
                   HorizontalTextAlignment="Center"
                   Margin="0,5,0,10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
